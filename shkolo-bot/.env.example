# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- Shkolo login (the parent account) ---
SHKOLO_USER=
SHKOLO_PASS=
# Only needed if your school uses a different host.
SHKOLO_BASE_URL=https://app.shkolo.bg

# Your son's name as it appears in Shkolo. Used to pick him if the account
# has several children, and to address the digest.
CHILD_NAME=

# Optional: comma-separated Shkolo pages to read. Leave empty to auto-detect
# (grades, absences, homework, remarks, messages, events). Run
# `npm run discover` to see the links the bot finds on your account.
SHKOLO_PAGES=

# --- Telegram delivery ---
# 1) In Telegram, talk to @BotFather -> /newbot -> copy the token here.
# 2) Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: friendly summary written by Claude ---
# Without a key the bot sends the raw list of what changed. With a key, only
# the changed text from Shkolo is sent to the Anthropic API to be summarised.
ANTHROPIC_API_KEY=

# Set to 1 to skip the message on days with nothing new.
QUIET_WHEN_NOTHING_NEW=0
# Set to 1 to watch the browser while it runs (debugging).
HEADFUL=0

# Optional: use an already-installed Chrome/Chromium instead of Playwright's.
CHROMIUM_PATH=
